# Even though the sentence_transformers library is fully typed, the
# library and its dependencies are so large that it isn't practical to
# include them in the mypy pre-commit dependency list. The types below
# are all that we really need right now.

class Embeddings:
    def tolist(self) -> list[float]: ...

class SentenceTransformer:
    def __init__(self, model: str, *, local_files_only: bool = False) -> None: ...
    def encode(self, data: str) -> Embeddings: ...
    def save(self, path: str) -> None: ...
