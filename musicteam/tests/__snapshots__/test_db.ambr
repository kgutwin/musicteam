  --
  -- Name: all_authors; Type: VIEW; Schema: public; Owner: -
  --
  
  CREATE VIEW public.all_authors AS
   SELECT DISTINCT unnest(authors) AS author,
      count(*) AS count
     FROM public.songs
    GROUP BY (unnest(authors))
    ORDER BY (unnest(authors));
  
  
