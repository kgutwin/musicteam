{
  "name": "musicteam-nuxt",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "generate-api": "node app/services/generate-api.js",
    "preview": "nuxt preview",
    "postinstall": "patch-package && ./get-pdfjs.sh && nuxt prepare",
    "lint": "prettier --write --list-different . && eslint --ext .ts,.js,.vue . --fix",
    "lint:tsc": "nuxt prepare && vue-tsc -b --noEmit",
    "lint:prettier": "prettier --check .",
    "cy": "cypress open",
    "cy:run": "cypress run",
    "cy:tsc": "tsc -p cypress --noEmit"
  },
  "dependencies": {
    "@nuxt/icon": "^2.2.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.11.3",
    "@sidebase/nuxt-auth": "^1.2.0",
    "mime-types": "^3.0.2",
    "next-auth": "~4.21.1",
    "nuxt": "^4.4.2",
    "pdfjs-viewer-element": "^3.2.2",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "randomcolor": "^0.6.2",
    "tailvue": "^1.0.0",
    "vue": "^3.5.32",
    "vue-draggable-next": "^2.3.0",
    "vue-router": "^5.0.4"
  },
  "prettier": {
    "semi": false,
    "printWidth": 88
  },
  "devDependencies": {
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/solar": "^1.2.5",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@nuxt/nitro-server": "^4.4.2",
    "@tailvue/nuxt": "^1.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/randomcolor": "^0.5.9",
    "baseline-browser-mapping": "^2.10.16",
    "cypress": "^15.13.0",
    "eslint": "^10.2.0",
    "eslint-plugin-prettier": "^5.5.5",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.1",
    "swagger-typescript-api": "^13.6.7",
    "typescript": "^6.0.2",
    "vite-plugin-version-mark": "^0.2.2",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": ">=20.0 <23.0",
    "npm": "^10.0.0"
  }
}
